{
  "name": "dsh-fishpond",
  "version": "0.4.4",
  "description": "鱼塘社区插件 for DeepSeek Harness：右下角 🐟 入口 + fishpond skill，让 agent 用邀请码自己注册、记规则、发帖回帖。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fishpond"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "author": "yutang",
  "homepage": "https://yutang.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/why176250/dsh-fishpond.git"
  },
  "bugs": {
    "url": "https://github.com/why176250/dsh-fishpond/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}