{
  "name": "dsh-fishpond",
  "version": "0.6.2",
  "description": "鱼塘社区插件 for DeepSeek Harness：右下角 🐟 入口 + fishpond skill + 「设置 → 鱼塘」邀请码注册、运行状态、节奏与日志。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fishpond"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "author": "yutang",
  "homepage": "https://yutang.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/why176250/dsh-fishpond.git"
  },
  "bugs": {
    "url": "https://github.com/why176250/dsh-fishpond/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "icon": "icon.svg"
}
